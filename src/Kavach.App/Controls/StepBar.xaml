<UserControl x:Class="Kavach.App.Controls.StepBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            >
    <Border Style="{StaticResource SoftCard}" Padding="16,11" Margin="0,0,0,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="01" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Step1, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource DividerBrush}" Margin="12,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                <TextBlock Text="02" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Step2, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
            <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource DividerBrush}" Margin="12,0"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="4,0,0,0">
                <TextBlock Text="03" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Step3, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
