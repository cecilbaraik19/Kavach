<Window x:Class="Kavach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kavach" Width="1280" Height="820" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/kavach.ico"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═════════ Header bar ═════════ -->
        <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Kavach shield logo -->
                    <Image Source="/Assets/kavach-shield.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Kavach" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Antivirus" FontSize="12" Margin="7,3,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Protection status pill -->
                    <Border x:Name="StatusPill" CornerRadius="13" Padding="11,5" Margin="0,0,10,0" Background="{DynamicResource SuccessSoftBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Protected" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="AdminButton" Style="{StaticResource GhostButton}" Click="AdminButton_Click"
                            ToolTip="Some tasks (quarantine of system files, startup items, hosts file) need administrator rights">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="13" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="Run as administrator" FontSize="12" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Click="ThemeButton_Click" ToolTip="Switch light / dark theme">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE708;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════ Sidebar + content ═════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,14,12,12">
                    <StackPanel DockPanel.Dock="Bottom">
                        <!-- Schedules card -->
                        <Button Style="{StaticResource TileButton}" Click="SchedulesCard_Click" Margin="0,0,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="12">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="14" VerticalAlignment="Top" Margin="2,1,10,0"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Schedules" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="ScheduleHint" Text="Automate scans on a schedule" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="BottomNav"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource PanelBgBrush}">
                <ContentControl x:Name="PageHost" Focusable="False"/>

                <!-- Small message bar at the bottom ("Moved to quarantine", errors …) -->
                <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                        CornerRadius="10" Padding="16,11" Background="{DynamicResource CardBgBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource CardBorderBrush}" MaxWidth="640">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Text="&#xE930;" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="560"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
