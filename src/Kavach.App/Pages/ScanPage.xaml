<UserControl x:Class="Kavach.App.Pages.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Kavach.App.Controls"
             AllowDrop="True" Drop="Page_Drop">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,28,34,30">
            <DockPanel LastChildFill="True">
                <!-- Action buttons sit beside the header (named controls cannot go inside PageHeader) -->
                <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,20" Focusable="False">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ExportButton" Style="{StaticResource SecondaryButton}" Click="Export_Click" Visibility="Collapsed" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Export report" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="Start_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                                <TextBlock x:Name="StartButtonText" Text="Start scan" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ContentControl>
                <c:PageHeader Glyph="&#xE721;" Eyebrow="PROTECTION" Title="Malware Scanner"
                          Subtitle="Scan files, folders, running programs and startup items for viruses, trojans, ransomware and spyware."/>
            </DockPanel>

            <c:StepBar Step1="Choose what to scan" Step2="Watch the scan" Step3="Review and remove threats"/>

            <!-- Scan type -->
            <UniformGrid x:Name="TypePanel" Columns="4" Margin="-6,0">
                <RadioButton x:Name="QuickRadio" Style="{StaticResource ChoiceCard}" GroupName="ScanType" Margin="6" IsChecked="True" Checked="Type_Checked">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="18" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock Text="Quick scan" Style="{StaticResource CardTitle}" Margin="0,10,0,4"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Downloads, desktop, temp, startup and running programs"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FullRadio" Style="{StaticResource ChoiceCard}" GroupName="ScanType" Margin="6" Checked="Type_Checked">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="18" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock Text="Full scan" Style="{StaticResource CardTitle}" Margin="0,10,0,4"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Every drive, every program, script and archive"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CustomRadio" Style="{StaticResource ChoiceCard}" GroupName="ScanType" Margin="6" Checked="Type_Checked">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="18" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock Text="Custom scan" Style="{StaticResource CardTitle}" Margin="0,10,0,4"/>
                        <TextBlock Style="{StaticResource Caption}" Text="A file, folder or USB drive you choose"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ProcessRadio" Style="{StaticResource ChoiceCard}" GroupName="ScanType" Margin="6" Checked="Type_Checked">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9F5;" FontSize="18" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock Text="Running programs" Style="{StaticResource CardTitle}" Margin="0,10,0,4"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Every program running right now"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <!-- Custom path -->
            <Border x:Name="CustomPanel" Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="Collapsed" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomPath" Style="{StaticResource Input}" ToolTip="Paste a path, or drag a file or folder onto this page"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Choose file" Margin="10,0,0,0" Click="ChooseFile_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Choose folder" Margin="10,0,0,0" Click="ChooseFolder_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="2,10,0,0"
                               Text="Tip: drag files onto this page, or right-click any file in Explorer → Scan with Kavach (turn it on in Preferences)."/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="FreshScan" Style="{StaticResource Check}" Margin="4,14,0,0"
                      Content="Re-check every file (ignore the list of files that were clean last time)"/>

            <!-- Progress -->
            <Border x:Name="ProgressCard" Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ProgressBubble" Style="{StaticResource IconBubble}" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock x:Name="ProgressIcon" Style="{StaticResource Icon}" Text="&#xE721;" FontSize="18" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressTitle" Style="{StaticResource CardTitle}" Text="Scanning…"/>
                            <TextBlock x:Name="ProgressSubtitle" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}" Click="Pause_Click" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PauseIcon" Style="{StaticResource Icon}" Text="&#xE769;" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="PauseText" Text="Pause" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelButton" Style="{StaticResource DangerButton}" Click="Cancel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock Text="Cancel" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="Bar" Style="{StaticResource Progress}" Margin="0,18,0,0" Maximum="100" IsIndeterminate="True"/>

                    <UniformGrid Columns="4" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Scanned"/>
                            <TextBlock x:Name="NumScanned" Style="{StaticResource BigNumber}" FontSize="22" Text="0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Skipped"/>
                            <TextBlock x:Name="NumSkipped" Style="{StaticResource BigNumber}" FontSize="22" Text="0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Threats"/>
                            <TextBlock x:Name="NumThreats" Style="{StaticResource BigNumber}" FontSize="22" Text="0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Time"/>
                            <TextBlock x:Name="NumTime" Style="{StaticResource BigNumber}" FontSize="22" Text="0s"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock x:Name="CurrentFile" Style="{StaticResource Mono}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- Clean result -->
            <Border x:Name="CleanCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed"
                    Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessSoftBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="22" Foreground="{DynamicResource SuccessBrush}"/>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="No threats found"/>
                        <TextBlock x:Name="CleanText" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Results -->
            <StackPanel x:Name="ResultsPanel" Margin="0,22,0,0" Visibility="Collapsed">
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,0" Text="THREATS FOUND"/>
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource DangerSoftBrush}" Margin="10,0,0,0">
                            <TextBlock x:Name="ResultCount" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="Select all" Click="SelectAll_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Allow selected" Click="AllowSelected_Click" Margin="8,0,0,0"
                                ToolTip="Not a virus: trust these files so Kavach never flags them again"/>
                        <Button Style="{StaticResource PrimaryButton}" Click="QuarantineSelected_Click" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                                <TextBlock Text="Quarantine selected" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="ResultList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,14,0"/>
                                    <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Top" Margin="0,1,12,0"
                                            Background="{Binding Level, Converter={StaticResource LevelSoftBrush}}">
                                        <TextBlock Text="{Binding LevelText}" FontSize="10" FontWeight="Bold" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ThreatName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding FileName, StringFormat='  •  {0}'}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Mono}" Margin="0,5,0,0" ToolTip="{Binding Location}"/>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="  •  running now" Style="{StaticResource Muted}" Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Action, StringFormat='  •  {0}'}" Style="{StaticResource Muted}" Foreground="{DynamicResource SuccessBrush}"
                                                       Visibility="{Binding IsHandled, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0"
                                                Visibility="{Binding IsHandled, Converter={StaticResource InverseBoolToVis}}">
                                        <Button Style="{StaticResource SmallButton}" Content="Folder" Click="OpenFolder_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource SmallButton}" Content="VirusTotal" Click="VirusTotal_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource SmallButton}" Content="Allow" Click="Allow_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource SmallDangerButton}" Content="Quarantine" Click="Quarantine_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- VirusTotal file lookup -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBubble}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="18" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Second opinion from VirusTotal"/>
                        <TextBlock x:Name="VtText" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                   Text="Check any file against 70+ antivirus engines. Only the file's SHA-256 fingerprint is sent, never the file."/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Check a file" Click="VtFile_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
