<UserControl x:Class="Kavach.App.Pages.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Kavach.App.Controls">
    <Grid Margin="34,28,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True">
            <!-- Action buttons sit beside the header (named controls cannot go inside PageHeader) -->
            <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,20" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="AutoRefresh" Style="{StaticResource Check}" Content="Live (every 3 s)" IsChecked="True" Margin="0,0,14,0" Click="AutoRefresh_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                            <TextBlock Text="Refresh" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ContentControl>
            <c:PageHeader Glyph="&#xE968;" Eyebrow="PROTECTION" Title="Network Monitor"
                      Subtitle="See which programs are talking to the internet right now, and stop the ones you don't trust."/>
        </DockPanel>

        <c:StepBar Grid.Row="1" Step1="Watch connections" Step2="Spot unknown programs" Step3="Stop what you don't trust"/>

        <UniformGrid Grid.Row="2" Columns="4" Margin="-8,0,-8,8">
            <Border Style="{StaticResource Card}" Margin="8" Padding="18,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Connections"/>
                    <TextBlock x:Name="NumTotal" Style="{StaticResource BigNumber}" FontSize="24" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8" Padding="18,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Established"/>
                    <TextBlock x:Name="NumEstablished" Style="{StaticResource BigNumber}" FontSize="24" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8" Padding="18,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Listening ports"/>
                    <TextBlock x:Name="NumListening" Style="{StaticResource BigNumber}" FontSize="24" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8" Padding="18,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Flagged"/>
                    <TextBlock x:Name="NumFlagged" Style="{StaticResource BigNumber}" FontSize="24" Text="0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Filter" Style="{StaticResource Input}" TextChanged="Filter_TextChanged" ToolTip="Filter by program, address, port or state"/>
            <TextBlock Text="Filter by program, address or port…" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Muted}" x:Name="FilterHint"/>
            <CheckBox x:Name="HideListening" Grid.Column="1" Style="{StaticResource Check}" Content="Hide listening" Margin="16,0,0,0" Click="Filter_Click"/>
            <CheckBox x:Name="HideLocal" Grid.Column="2" Style="{StaticResource Check}" Content="Hide local traffic" Margin="16,0,0,0" IsChecked="True" Click="Filter_Click"/>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="18,12,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="PROGRAM"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Eyebrow}" Text="TYPE"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="LOCAL"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource Eyebrow}" Text="REMOTE"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource Eyebrow}" Text="STATE"/>
                </Grid>
                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Bottom"/>
                <ListBox x:Name="ConnList" Grid.Row="1" Style="{StaticResource PlainList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18,8" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{Binding Risk, Converter={StaticResource LevelBrush}}"/>
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding ProcessId, StringFormat='  PID {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" Foreground="{DynamicResource DangerBrush}"
                                                   Visibility="{Binding Reason, Converter={StaticResource NullToCollapsed}}" Margin="15,2,0,0"/>
                                        <TextBlock Text="{Binding ProcessPath}" Style="{StaticResource Mono}" FontSize="10.5" Margin="15,2,0,0"
                                                   ToolTip="{Binding ProcessPath}" Visibility="{Binding ProcessPath, Converter={StaticResource NullToCollapsed}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Protocol}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Local}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Remote}" Style="{StaticResource Mono}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding State}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="5" Style="{StaticResource SmallDangerButton}" Content="Stop" Tag="{Binding}" Click="Kill_Click"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="Stop this program"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
