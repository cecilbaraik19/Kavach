<UserControl x:Class="Kavach.App.Pages.QuarantinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Kavach.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,28,34,30">
            <DockPanel LastChildFill="True">
                <!-- Action buttons sit beside the header (named controls cannot go inside PageHeader) -->
                <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,20" Focusable="False">
                    <Button x:Name="DeleteAllButton" Style="{StaticResource DangerButton}" Click="DeleteAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="Delete all" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </ContentControl>
                <c:PageHeader Glyph="&#xE72E;" Eyebrow="MANAGE" Title="Quarantine"
                          Subtitle="Threats are locked away here, encrypted so they can never run. Restore a false alarm or delete threats for good."/>
            </DockPanel>
            <c:StepBar Step1="Review what was caught" Step2="Restore false alarms" Step3="Delete the rest"/>

            <UniformGrid Columns="3" Margin="-8,0,-8,8">
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Items in quarantine"/>
                        <TextBlock x:Name="NumItems" Style="{StaticResource BigNumber}" Text="0" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Space used"/>
                        <TextBlock x:Name="NumSize" Style="{StaticResource BigNumber}" Text="0 B" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Threats blocked (all time)"/>
                        <TextBlock x:Name="NumBlocked" Style="{StaticResource BigNumber}" Text="0" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border x:Name="EmptyCard" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="28">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Quarantine is empty" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock Style="{StaticResource Caption}" Text="When Kavach catches a threat, it will appear here." HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="ItemList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Badge}" VerticalAlignment="Top" Margin="0,2,14,0"
                                        Background="{Binding Level, Converter={StaticResource LevelSoftBrush}}">
                                    <TextBlock Text="{Binding LevelText}" FontSize="10" FontWeight="Bold" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ThreatName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding FileName, StringFormat='  •  {0}'}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OriginalPath}" Style="{StaticResource Mono}" Margin="0,5,0,0" ToolTip="{Binding OriginalPath}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding SizeText, StringFormat='  •  {0}'}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding ShortHash, StringFormat='  •  SHA-256 {0}'}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="VirusTotal" Tag="{Binding}" Click="VirusTotal_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource SmallSuccessButton}" Content="Restore" Tag="{Binding}" Click="Restore_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource SmallDangerButton}" Content="Delete" Tag="{Binding}" Click="Delete_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
