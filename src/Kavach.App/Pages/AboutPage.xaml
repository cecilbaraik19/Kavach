<UserControl x:Class="Kavach.App.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,40,34,30" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <!-- Official Kavach logo (on white so the blue lettering is readable in both themes) -->
                <Border Background="White" CornerRadius="16" Padding="18,14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Image Source="/Assets/kavach-logo-full.png" Width="150" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Margin="26,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HeroTitle}" Text="Kavach Antivirus"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource PageSubtitle}" FontSize="14" Margin="0,4,0,0"
                               Text="Kavach Antivirus v1.0, developed by Cecil Baraik"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Powered by Cecil Baraik"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,22,0,0" FontSize="13.5"
                       Text="Kavach (कवच) means “armour”. It protects Windows PCs with real-time file protection, a multi-engine malware scanner, ransomware bait files, USB protection, startup and hosts checks, a network monitor and a quarantine vault — running as a Windows service so protection is always on."/>

            <UniformGrid Columns="2" Margin="-8,22,-8,0">
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Detection engine"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" LineHeight="20"
                                   Text="• SHA-256 known-malware hashes (MalwareBazaar)&#x0a;• YARA-compatible rule engine&#x0a;• PE heuristics: packers, entropy, injection / keylogger APIs&#x0a;• Script analysis: PowerShell, VBS, JS, BAT, HTA, LNK&#x0a;• ZIP / RAR / 7z / TAR / GZ scanning&#x0a;• Fake system files, double extensions, RTLO tricks&#x0a;• Authenticode signature checks"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Built with"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" LineHeight="20"
                                   Text="• C# 12 and .NET 8&#x0a;• WPF desktop interface&#x0a;• Windows Service (Microsoft.Extensions.Hosting)&#x0a;• Win32 APIs: WinVerifyTrust, IP Helper, process security&#x0a;• SharpCompress for archives&#x0a;• Named pipes between service and app"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Kavach updates -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Kavach updates"/>
                        <TextBlock x:Name="UpdateText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Kavach checks GitHub for a new version once a day."/>
                        <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource SecondaryButton}" Content="Check for updates" Click="CheckUpdate_Click"/>
                        <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}" Content="Download and install" Margin="8,0,0,0"
                                Visibility="Collapsed" Click="InstallUpdate_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- EICAR test -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Test that protection works"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="Creates the EICAR test file on your Desktop. It is completely harmless — every antivirus in the world detects it on purpose. Kavach should block it within a few seconds. (Windows Defender may catch it first; that is fine too.)"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Create EICAR test file" Margin="16,0,0,0" VerticalAlignment="Center" Click="Eicar_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SoftCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="PathsText" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SmallButton}" Content="Open data folder" Click="OpenData_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SmallButton}" Content="Open program folder" Click="OpenApp_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Muted}" Margin="2,18,0,0" TextWrapping="Wrap"
                       Text="© 2026 Cecil Baraik. Kavach is a personal project. Keep Microsoft Defender turned on as well — no single antivirus catches everything."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
