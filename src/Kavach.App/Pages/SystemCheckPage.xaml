<UserControl x:Class="Kavach.App.Pages.SystemCheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Kavach.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,28,34,30">
            <DockPanel LastChildFill="True">
                <!-- Action buttons sit beside the header (named controls cannot go inside PageHeader) -->
                <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,20" Focusable="False">
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Click="Run_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                            <TextBlock x:Name="RunText" Text="Check now" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </ContentControl>
                <c:PageHeader Glyph="&#xE9D9;" Eyebrow="PROTECTION" Title="System Check"
                          Subtitle="Find malware that starts with Windows, hijacked system settings and a tampered hosts file."/>
            </DockPanel>
            <c:StepBar Step1="Check startup items" Step2="Review what looks wrong" Step3="Disable or restore"/>

            <UniformGrid Columns="3" Margin="-8,0">
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Startup items"/>
                        <TextBlock x:Name="NumItems" Style="{StaticResource BigNumber}" Text="—" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Run keys, Startup folders, tasks, services"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Need attention"/>
                        <TextBlock x:Name="NumRisky" Style="{StaticResource BigNumber}" Text="—" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Medium risk or higher"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Hosts file"/>
                        <TextBlock x:Name="HostsState" Style="{StaticResource BigNumber}" Text="—" Margin="0,8,0,0"/>
                        <TextBlock x:Name="HostsInfo" Style="{StaticResource Muted}" Text="Website redirects"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Hosts details -->
            <Border x:Name="HostsCard" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed"
                    Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerSoftBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Your hosts file has suspicious redirects"/>
                        <TextBlock x:Name="HostsDetails" Style="{StaticResource Caption}" Margin="0,6,0,0" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Reset hosts file" VerticalAlignment="Center" Click="ResetHosts_Click"/>
                </Grid>
            </Border>

            <Grid Margin="2,24,0,10">
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="WHAT STARTS WITH WINDOWS"/>
                <CheckBox x:Name="OnlyRisky" Style="{StaticResource Check}" HorizontalAlignment="Right" Content="Only show items that need attention"
                          Click="Filter_Click"/>
            </Grid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Text="Press “Check now” to list everything that starts automatically." Margin="2,0,0,10"/>
            <ItemsControl x:Name="ItemList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Badge}" VerticalAlignment="Top" Margin="0,2,0,0"
                                        Background="{Binding Level, Converter={StaticResource LevelSoftBrush}}">
                                    <TextBlock Text="{Binding LevelText}" FontSize="10" FontWeight="Bold" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding SourceText, StringFormat='  •  {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource Mono}" Margin="0,4,0,0" ToolTip="{Binding Command}"/>
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="Folder" Tag="{Binding}" Click="Folder_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource SmallDangerButton}" Content="Disable" Tag="{Binding}" Click="Disable_Click"
                                            Visibility="{Binding CanDisable, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="DISABLED BY YOU" Margin="2,24,0,10"/>
            <TextBlock x:Name="NoDisabled" Style="{StaticResource Muted}" Text="Nothing disabled yet. Disabled items can be restored here." Margin="2,0,0,0"/>
            <ItemsControl x:Name="DisabledList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SoftCard}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource Mono}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SmallSuccessButton}" Content="Restore" Tag="{Binding}" Click="Restore_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
