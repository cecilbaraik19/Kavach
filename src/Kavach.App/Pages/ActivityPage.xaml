<UserControl x:Class="Kavach.App.Pages.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Kavach.App.Controls">
    <Grid Margin="34,28,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <!-- Action buttons sit beside the header (named controls cannot go inside PageHeader) -->
            <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,20" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="Clear" Click="Clear_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Export" Click="Export_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Refresh" Click="Refresh_Click"/>
                </StackPanel>
            </ContentControl>
            <c:PageHeader Glyph="&#xE7C3;" Eyebrow="YOUR WORKSPACE" Title="Activity Log"
                      Subtitle="Everything Kavach and its service did: scans, detections, quarantine, settings changes and errors."/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="LogFilter" Content="All" IsChecked="True" Tag="All" Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="LogFilter" Content="Threats" Tag="Threat" Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="LogFilter" Content="Warnings" Tag="Warning" Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="LogFilter" Content="Errors" Tag="Error" Checked="Filter_Checked"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="CountText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListBox x:Name="LogList" Style="{StaticResource PlainList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18,9" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"/>
                                <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding Level, Converter={StaticResource LevelSoftBrush}}">
                                    <TextBlock Text="{Binding LevelText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource Caption}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
