<UserControl x:Class="Kavach.App.Pages.PreferencesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Kavach.App.Controls">
    <Grid>
        <!-- Lock screen (when a settings password is set) -->
        <Border x:Name="LockPanel" Visibility="Collapsed" Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Padding="28">
            <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Preferences are locked" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Style="{StaticResource Caption}" Text="Enter the settings password to change Kavach's preferences." HorizontalAlignment="Center" TextAlignment="Center"/>
                <PasswordBox x:Name="UnlockBox" Style="{StaticResource PasswordInput}" Margin="0,16,0,0" KeyDown="UnlockBox_KeyDown"/>
                <TextBlock x:Name="UnlockError" Style="{StaticResource Caption}" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Unlock" Margin="0,12,0,0" Click="Unlock_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="MainContent" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,28,34,30">
                <c:PageHeader Glyph="&#xE713;" Eyebrow="SETTINGS" Title="Preferences"
                              Subtitle="Tune how Kavach scans, how much of your PC it uses, and how it fits into Windows."/>

                <!-- Scanning -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="SCANNING"/>
                <Border Style="{StaticResource Card}" Padding="20,8">
                    <StackPanel x:Name="ScanSettings">
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Look inside archives"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Scan files inside ZIP, RAR, 7z, TAR and GZ archives (protected against zip bombs)."/>
                            </StackPanel>
                            <CheckBox x:Name="ScanArchives" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Save_Click"/>
                        </Grid>
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Skip big media files"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Videos, music and pictures over 2 MB cannot run code. Skipping them makes scans much faster."/>
                            </StackPanel>
                            <CheckBox x:Name="SkipMedia" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Save_Click"/>
                        </Grid>
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Remember clean files (scan cache)"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Files that have not changed since a clean scan are skipped until signatures update."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SmallButton}" Content="Clear cache" Click="ClearCache_Click" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="UseCache" Style="{StaticResource Switch}" Click="Save_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Largest file to scan"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Bigger files are only checked by name. Most malware is smaller than 50 MB."/>
                            </StackPanel>
                            <ComboBox x:Name="MaxSize" Style="{StaticResource Combo}" HorizontalAlignment="Right" Width="140" SelectionChanged="Save_Changed">
                                <ComboBoxItem Content="25 MB" Tag="25"/>
                                <ComboBoxItem Content="50 MB" Tag="50"/>
                                <ComboBoxItem Content="100 MB" Tag="100"/>
                                <ComboBoxItem Content="250 MB" Tag="250"/>
                                <ComboBoxItem Content="500 MB" Tag="500"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Performance -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="PERFORMANCE" Margin="2,24,0,10"/>
                <Border Style="{StaticResource Card}" Padding="20,8">
                    <StackPanel>
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Scan speed"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Low uses one CPU core at low priority — slowest, but you won't notice it."/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PerfLow" Style="{StaticResource Segment}" GroupName="Perf" Content="Low" Click="Save_Click"/>
                                    <RadioButton x:Name="PerfBalanced" Style="{StaticResource Segment}" GroupName="Perf" Content="Balanced" Click="Save_Click"/>
                                    <RadioButton x:Name="PerfFast" Style="{StaticResource Segment}" GroupName="Perf" Content="Fast" Click="Save_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Pause scheduled scans on battery"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Wait until the laptop is plugged in."/>
                            </StackPanel>
                            <CheckBox x:Name="PauseBattery" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Save_Click"/>
                        </Grid>
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Pause during games and full-screen videos"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Scheduled and USB scans wait while a full-screen app is running."/>
                            </StackPanel>
                            <CheckBox x:Name="PauseFullscreen" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Save_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Windows integration -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="WINDOWS" Margin="2,24,0,10"/>
                <Border Style="{StaticResource Card}" Padding="20,8">
                    <StackPanel>
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="“Scan with Kavach” in the right-click menu"/>
                                <TextBlock Style="{StaticResource Caption}" Text="For files, folders and drives. On Windows 11 it is under “Show more options”."/>
                            </StackPanel>
                            <CheckBox x:Name="ContextMenuToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Save_Click"/>
                        </Grid>
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Start Kavach with Windows"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Starts quietly in the tray to show alerts and protect you."/>
                            </StackPanel>
                            <CheckBox x:Name="StartWithWindows" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Save_Click"/>
                        </Grid>
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Keep running in the tray when the window is closed"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Exit from the tray icon menu."/>
                            </StackPanel>
                            <CheckBox x:Name="MinimizeToTray" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Save_Click"/>
                        </Grid>
                        <Grid Margin="0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Theme"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Dark or light."/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="Theme" Content="Dark" Click="Save_Click"/>
                                    <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="Theme" Content="Light" Click="Save_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Online -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="ONLINE SERVICES (OPTIONAL)" Margin="2,24,0,10"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="VirusTotal API key"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,8" Text="Free from virustotal.com → your profile → API key. Used only when you press a VirusTotal button; only file fingerprints are sent."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="VtKey" Style="{StaticResource PasswordInput}"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Get a key" Margin="10,0,0,0" Click="VtLink_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="abuse.ch Auth-Key" Margin="0,18,0,0"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,8" Text="Free from auth.abuse.ch. Needed if MalwareBazaar refuses signature downloads."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="AbuseKey" Style="{StaticResource PasswordInput}"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Get a key" Margin="10,0,0,0" Click="AbuseLink_Click"/>
                        </Grid>
                        <Button Style="{StaticResource PrimaryButton}" Content="Save keys" HorizontalAlignment="Left" Margin="0,16,0,0" Click="SaveKeys_Click"/>
                    </StackPanel>
                </Border>

                <!-- Security -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="SECURITY" Margin="2,24,0,10"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Settings password"/>
                        <TextBlock x:Name="PasswordState" Style="{StaticResource Caption}" Margin="0,3,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="NewPassword" Style="{StaticResource PasswordInput}" ToolTip="New password (at least 4 characters)"/>
                            <PasswordBox x:Name="RepeatPassword" Grid.Column="2" Style="{StaticResource PasswordInput}" ToolTip="Repeat password"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Set password" Click="SetPassword_Click"/>
                                <Button x:Name="RemovePasswordButton" Style="{StaticResource DangerButton}" Content="Remove" Margin="8,0,0,0" Click="RemovePassword_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="With a password, nobody else can turn off protection, change preferences, restore quarantined files or exit Kavach."/>
                    </StackPanel>
                </Border>

                <!-- Service -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="BACKGROUND SERVICE" Margin="2,24,0,10"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="Kavach service"/>
                            <TextBlock x:Name="ServiceText" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
