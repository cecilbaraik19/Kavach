<UserControl x:Class="Kavach.App.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Kavach.App.Controls">
    <Grid Margin="34,28,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <!-- Action buttons sit beside the header (named controls cannot go inside PageHeader) -->
            <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,20" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="Clear history" Click="Clear_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Content="Export report" Click="Export_Click"/>
                </StackPanel>
            </ContentControl>
            <c:PageHeader Glyph="&#xE81C;" Eyebrow="YOUR WORKSPACE" Title="Scan History"
                      Subtitle="Every scan and every threat Kavach has stopped, with what was done about it."/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ScanList" Style="{StaticResource PlainList}" SelectionChanged="ScanList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,6,8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding When}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="7" Height="7" Fill="{Binding Level, Converter={StaticResource LevelBrush}}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Result}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Detail">
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource CardTitle}" FontSize="18" Text="Choose a scan"/>
                        <TextBlock x:Name="DetailSub" Style="{StaticResource Caption}" Margin="0,4,0,14"/>
                        <UniformGrid x:Name="DetailNumbers" Columns="4" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="Scanned"/>
                                <TextBlock x:Name="DScanned" Style="{StaticResource BigNumber}" FontSize="20"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="Skipped"/>
                                <TextBlock x:Name="DSkipped" Style="{StaticResource BigNumber}" FontSize="20"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="Threats"/>
                                <TextBlock x:Name="DThreats" Style="{StaticResource BigNumber}" FontSize="20"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="Duration"/>
                                <TextBlock x:Name="DDuration" Style="{StaticResource BigNumber}" FontSize="20"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="DTargets" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <ItemsControl x:Name="DDetections">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Badge}" VerticalAlignment="Top" Background="{Binding Level, Converter={StaticResource LevelSoftBrush}}">
                                                <TextBlock Text="{Binding LevelText}" FontSize="10" FontWeight="Bold" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ThreatName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Location}" Style="{StaticResource Mono}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Action, StringFormat='Action: {0}'}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="DClean" Style="{StaticResource Caption}" Foreground="{DynamicResource SuccessBrush}" Text="No threats in this scan."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
