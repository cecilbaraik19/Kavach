<UserControl x:Class="Kavach.App.Pages.RealTimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Kavach.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,28,34,30">
            <c:PageHeader Glyph="&#xE945;" Eyebrow="PROTECTION" Title="Real-time Protection"
                          Subtitle="Kavach watches your files all the time and stops threats the moment they appear."/>
            <c:StepBar Step1="Turn protection on" Step2="Choose what to watch" Step3="Kavach handles the rest"/>

            <!-- Master switch, like the Game Mode card -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MasterBubble" Width="76" Height="76" CornerRadius="16" Background="{DynamicResource SuccessSoftBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="MasterIcon" Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MasterState" Text="ON" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="Real-time protection" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="MasterText" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="HostText" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button x:Name="MasterButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="Master_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                            <TextBlock x:Name="MasterButtonText" Text="TURN OFF" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="PROTECTION FEATURES" Margin="2,24,0,10"/>
            <StackPanel x:Name="FeatureList"/>

            <!-- Watched folders -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="WATCHED FOLDERS" Margin="2,24,0,10"/>
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Kavach always watches Downloads, Desktop, Documents, Temp, the Startup folders and every USB drive. Add more folders here:"/>
                    <ItemsControl x:Name="DefaultFolders" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12"/>
                                    <TextBlock Style="{StaticResource Mono}" Text="{Binding}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="ExtraFolders" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding}" Margin="10,0,0,0" Foreground="{DynamicResource TextBrush}"/>
                                    <Button Grid.Column="2" Style="{StaticResource SmallDangerButton}" Content="Remove" Tag="{Binding}" Click="RemoveFolder_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="AddFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Add folder" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Live events -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="LIVE ALERTS" Margin="2,24,0,10"/>
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="NoEvents" Style="{StaticResource Muted}" Text="No alerts yet. Try it: About → Create EICAR test file. Kavach should block it within seconds."/>
                    <ItemsControl x:Name="EventList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" Width="70"/>
                                    <Ellipse Grid.Column="1" Width="8" Height="8" Margin="4,4,12,0" VerticalAlignment="Top" Fill="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
