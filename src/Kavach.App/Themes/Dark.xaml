<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kavach dark theme (default) -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#0A0D11"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="#0F1318"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#0D1115"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#151A21"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1B2129"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#242B34"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1D232B"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#11161C"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#161B22"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1E1A12"/>

    <SolidColorBrush x:Key="TextBrush" Color="#E7E9EC"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#A4ACB6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6F7883"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#F5A524"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFB843"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#F7B13C"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A1206"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2B2110"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#11291A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F05252"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#33161A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#30240C"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#12233A"/>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2C343E"/>
    <Color x:Key="ShadowColor">#000000</Color>
</ResourceDictionary>
