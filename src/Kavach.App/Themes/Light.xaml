<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kavach light theme -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#E9ECF0"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#EEF0F3"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DDE1E6"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E3E6EA"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E3E6EA"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#FBEFD9"/>

    <SolidColorBrush x:Key="TextBrush" Color="#14181D"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#7A838E"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#F0A020"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F6B03A"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#B86E00"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A1206"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FCEBCB"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#DBEAFE"/>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3C9D0"/>
    <Color x:Key="ShadowColor">#55000000</Color>
</ResourceDictionary>
